function handleLogoUpload(e){const file=e.target.files[0]; if(!file) return; if(file.size>1024*1024){alert("❌ File terlalu besar, max 1MB"); return;} const reader=new FileReader(); reader.onload=function(ev){customLogo=ev.target.result; save("anton_logo_v4", customLogo); document.getElementById("logoPreview").src=customLogo; document.getElementById("sidebarLogo").src=customLogo; document.getElementById("topLogo").src=customLogo; renderStrukPrev(); alert("✅ Logo berhasil diupload!");}; reader.readAsDataURL(file);}
