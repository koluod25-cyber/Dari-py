function savePrinter(){printer.headerText=document.getElementById("hInp").value; printer.footerText=document.getElementById("fInp").value; printer.warrantyText=document.getElementById("wInp").value; printer.nib=document.getElementById("nibInp")?.value||"NIB : 2308230071069"; printer.address=document.getElementById("addrInp")?.value||"Jl. Trans Sulawesi, Kel. Rumoong Bawah, Kec. Amurang Barat, Kab. Minahasa Selatan."; printer.phone=document.getElementById("phoneInp")?.value||"TLP. 0812-818-98808"; printer.bluetoothName=document.getElementById("btName")?.value||""; printer.ipAddress=document.getElementById("ipAddr")?.value||""; printer.connectionType=document.getElementById("connType")?.value||"Bluetooth"; printer.showLogo=document.getElementById("showLogoCheck")?.checked; printer.autoConnect=document.getElementById("autoConn")?.checked||false; printer.fontFamily=document.getElementById("fontFamily")?.value||"monospace"; printer.fontSize=document.getElementById("fontSize")?.value||"11px"; printer.headerFontSize=document.getElementById("headerFontSize")?.value||"14px"; printer.fontWeight=document.getElementById("fontWeight")?.value||"normal"; save("anton_printer_v4",printer); alert("✅ Semua setting disimpan!\n"+printer.nib+"\nFont: "+printer.fontFamily+" "+printer.fontSize); render();}
function renderStrukPrev(){
  const el=document.getElementById("strukPrev"); 
  if(!el) return;
  const sample=transactions[0]||{noNota:"AS-TEST", customer:"Umum", total:250000, items:[{name:"Service AC", qty:1, price:250000}]};
  const logoHtml=printer.showLogo?`<div style="text-align:center"><img src="${customLogo}" style="width:50px;height:50px;border-radius:50%;object-fit:cover;margin-bottom:4px"><br></div>`:"";
  let paperWidth, paperLabel, bgColor, borderStyle;
  if(printer.size==="58mm"){ paperWidth="220px"; paperLabel="58mm - Kecil (220px)"; bgColor="#fef3c7"; borderStyle="2px dashed #f59e0b"; }
  else if(printer.size==="80mm"){ paperWidth="300px"; paperLabel="80mm - Besar (300px)"; bgColor="#dcfce7"; borderStyle="2px solid #22c55e"; }
  else { paperWidth="100%"; paperLabel="A4 - HVS (Full)"; bgColor="#dbeafe"; borderStyle="2px solid #3b82f6"; }
  el.style.width="100%"; el.style.display="flex"; el.style.justifyContent="center"; el.style.padding="10px"; el.style.background="#f1f5f9"; el.style.borderRadius="12px";
  el.innerHTML=`<div style="width:${paperWidth};max-width:100%;background:${bgColor};border:${borderStyle};border-radius:8px;padding:12px;font-family:${printer.fontFamily||"monospace"};font-size:${printer.fontSize||"11px"};font-weight:${printer.fontWeight||"normal"};line-height:1.4;transition:all 0.3s ease;box-shadow:0 2px 8px rgba(0,0,0,.1)">
    <div style="text-align:center;font-size:9px;font-weight:800;background:#000;color:#fff;padding:3px 6px;border-radius:999px;margin-bottom:8px">PREVIEW: ${paperLabel}</div>
    ${logoHtml}
    <div style="text-align:center;font-weight:800;font-size:${printer.headerFontSize||"14px"};line-height:1.2">ANTON SERVICE</div>
    <div style="text-align:center;font-weight:800;font-size:10px;color:#c1272d">ELECTRICAL ENGINEERING</div>
    <div style="text-align:center;font-size:8px;margin-top:4px;line-height:1.3">${printer.nib||"NIB : 2308230071069"}<br>${printer.address||"Jl. Trans Sulawesi, Kel. Rumoong Bawah, Kec. Amurang Barat, Kab. Minahasa Selatan."}<br>${printer.phone||"TLP. 0812-818-98808"}</div>
    <div style="text-align:center;font-size:10px;margin:6px 0;font-weight:600">${printer.headerText||""}</div>
    <hr style="margin:8px 0;border-style:dashed">
    <div>No: ${sample.noNota}</div><div>Pel: ${sample.customer}</div>
    <hr style="margin:8px 0;border-style:dashed">
    ${sample.items.map(i=>`<div><b>${i.name}</b><div style="display:flex;justify-content:space-between"><span>${i.qty} x ${i.price.toLocaleString("id-ID")}</span><span>${(i.qty*i.price).toLocaleString("id-ID")}</span></div></div>`).join("")}
    <hr style="margin:8px 0;border-style:dashed">
    <div style="display:flex;justify-content:space-between;font-weight:800"><span>TOTAL</span><span>Rp ${sample.total.toLocaleString("id-ID")}</span></div>
    <hr style="margin:8px 0;border-style:dashed">
    <div style="text-align:center;font-size:9px">${printer.footerText||"Terima kasih"}<br>${printer.warrantyText||"Garansi 30 Hari"}</div>
    <div style="margin-top:10px;padding:8px;background:#fff;border-radius:8px">
      <div style="font-size:10px;font-weight:700;text-align:center;margin-bottom:4px">🔖 BARCODE GARANSI</div>
      <div style="display:flex;justify-content:center">${generateBarcodeSVG("WR-"+sample.noNota.replace("AS-",""), 180, 35)}</div>
    </div>
    <div style="text-align:center;font-size:8px;margin-top:8px;color:#000;background:#fff;padding:4px;border-radius:4px;font-weight:600">KERTAS: ${paperLabel} | FONT: ${printer.fontFamily||"monospace"} ${printer.fontSize||"11px"} ${printer.fontWeight||"normal"} | HEADER: ${printer.headerFontSize||"14px"}</div>
  </div>`;
}

render();
</script>
<script>
// Force set logo immediately on load
document.addEventListener("DOMContentLoaded", function(){
  const logoDef = "data:image/jpeg;base64,";
  const savedLogo = localStorage.getItem("anton_logo_v4");
  let finalLogo = logoDef;
  try{ if(savedLogo) finalLogo = JSON.parse(savedLogo); }catch(e){ finalLogo = savedLogo || logoDef; }
  const hls=document.getElementById("headerLogoSmall");
  if(hls){ hls.src=finalLogo; hls.style.background="#fff"; hls.style.display="block"; hls.onerror=function(){this.src=logoDef;}; }
  const sl=document.getElementById("sidebarLogo"); if(sl) sl.src=finalLogo;
});
</script>
</body>
