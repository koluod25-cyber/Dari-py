function generateBarcodeSVG(text, width=200, height=50){
  // Simple Code128-like visual (not fully spec, but looks like barcode)
  let hash=0; for(let i=0;i<text.length;i++) hash = ((hash<<5)-hash)+text.charCodeAt(i);
  let bars = [];
  for(let i=0;i<text.length;i++){
    let code = text.charCodeAt(i);
    let pattern = (code % 8) + 2; // varying bar width
    bars.push(pattern);
  }
  // Add start/stop
  let total = bars.reduce((a,b)=>a+b,0) + 20;
  let x=10; let svg=`<svg width="${width}" height="${height+20}" viewBox="0 0 ${width} ${height+20}" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="white"/>`;
  bars.forEach((w,i)=>{
    let bw = (w/total)*width*0.8;
    let isBlack = i%2===0;
    if(isBlack) svg+=`<rect x="${x}" y="5" width="${Math.max(1,bw)}" height="${height}" fill="black"/>`;
    x+=bw;
  });
  // start and end thick bars
  svg+=`<rect x="5" y="5" width="2" height="${height}" fill="black"/><rect x="${width-7}" y="5" width="2" height="${height}" fill="black"/>`;
  svg+=`<text x="${width/2}" y="${height+15}" font-family="monospace" font-size="10" text-anchor="middle" fill="black">${text}</text></svg>`;
  return svg;
}
function generateWarrantyCode(nota){
  // Format: WR-AS-YYYYMMDD-XXX + checksum
  return "WR-"+nota.replace("AS-","")+"-"+Math.floor(Math.random()*90+10);
}
