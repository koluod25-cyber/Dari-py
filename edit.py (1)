// POS
function renderProd(){const q=(document.getElementById("searchProd")?.value||"").toLowerCase(); const list=products.filter(p=>p.name.toLowerCase().includes(q) || (p.barcode||"").toLowerCase().includes(q) || (p.sku||"").toLowerCase().includes(q)); document.getElementById("prodGrid").innerHTML=list.map(p=>`<button class="product" onclick="addToCart('${p.id}')"><div style="font-weight:600;font-size:13px">${p.name}</div><div style="font-size:10px;color:#64748b">${p.category} • Stok ${p.stock}</div><div style="font-size:9px;color:#94a3b8;margin-top:2px">SKU: ${p.sku||"-"} | BC: ${p.barcode||"-"}</div><div style="font-weight:800;margin-top:4px">Rp ${p.price.toLocaleString("id-ID")}</div></button>`).join("");}
function renderCart(){const el=document.getElementById("cartList"); if(!el) return; if(cart.length===0){el.innerHTML=`<div style="text-align:center;color:#94a3b8;font-size:12px;padding:16px">Kosong - tap produk</div>`;} else{el.innerHTML=cart.map(c=>`<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #f1f5f9;font-size:12px"><span>${c.name} x${c.qty}</span><span style="display:flex;gap:4px;align-items:center"><button onclick="chgQty('${c.id}',-1)" style="width:24px;height:24px;border-radius:6px;border:1px solid #e5e7eb">-</button><button onclick="chgQty('${c.id}',1)" style="width:24px;height:24px;border-radius:6px;border:1px solid #e5e7eb">+</button><button onclick="removeCart('${c.id}')" style="color:#ef4444;margin-left:4px">✕</button></span></div>`).join("");}
  const sub=cart.reduce((a,b)=>a+b.price*b.qty,0); const afterDisc=Math.max(0,sub-discount); const taxAmt=afterDisc*tax/100; const final=afterDisc+taxAmt;
  document.getElementById("subTotal").innerText="Rp "+sub.toLocaleString("id-ID"); document.getElementById("finalTotal").innerText="Rp "+Math.round(final).toLocaleString("id-ID");
}
function addToCart(id){const p=products.find(x=>x.id===id); const ex=cart.find(x=>x.id===id); if(ex) ex.qty++; else cart.push({...p, qty:1}); renderCart();}
function chgQty(id,d){const it=cart.find(x=>x.id===id); if(!it) return; it.qty=Math.max(1,it.qty+d); renderCart();}
function removeCart(id){cart=cart.filter(x=>x.id!==id); renderCart();}
function saveTrans(shouldPrint){if(cart.length===0){alert("Keranjang kosong! Tambah produk dulu");return;} const sub=cart.reduce((a,b)=>a+b.price*b.qty,0); const afterDisc=Math.max(0,sub-discount); const taxAmt=afterDisc*tax/100; const final=Math.round(afterDisc+taxAmt); const addr = customerAddr||""; const phone = customerPhone||"";
  let jasa=cart.filter(c=>c.category==="Jasa").reduce((a,b)=>a+b.price*b.qty,0); let spare=cart.filter(c=>c.category!=="Jasa").reduce((a,b)=>a+b.price*b.qty,0);
  let jFinal=jasa, sFinal=spare; if(discount>0){if(sFinal>=discount) sFinal-=discount; else{const sisa=discount-sFinal; sFinal=0; jFinal=Math.max(0,jFinal-sisa);}} 
  if(tax>0){const totalJS=jFinal+sFinal; if(totalJS>0){const jRatio=jFinal/totalJS; const sRatio=sFinal/totalJS; const taxJ=Math.round(taxAmt*jRatio); const taxS=Math.round(taxAmt*sRatio); jFinal+=taxJ; sFinal+=taxS;}}
  const nota="AS-"+new Date().getFullYear()+String(new Date().getMonth()+1).padStart(2,'0')+String(new Date().getDate()).padStart(2,'0')+"-"+String(transactions.length+1).padStart(3,'0');
  const tr={id:"T"+Date.now(), noNota:nota, date:new Date().toISOString(), items:cart.map(c=>({name:c.name, price:c.price, qty:c.qty, category:c.category, productId:c.id})), subtotal:sub, discount:discount, tax:tax, taxAmount:Math.round(taxAmt), total:final, customer:customer||"Umum", customerAddr:addr, customerPhone:phone, jasaTotal:jFinal, spareTotal:sFinal};
  transactions.unshift(tr); products=products.map(p=>{const it=cart.find(c=>c.id===p.id); if(!it||p.category==="Jasa") return p; return {...p, stock:Math.max(0,p.stock-it.qty)};}); save("anton_transactions_v4",transactions); save("anton_products_v4",products); cart=[]; discount=0; tax=0; customer=""; customerAddr=""; customerPhone="";
  if(shouldPrint){previewTrans(tr.id, true);} else{alert("✅ Simpan "+nota+" Berhasil!\n401 Jasa +Rp "+jFinal.toLocaleString("id-ID")+"\n402 Spare +Rp "+sFinal.toLocaleString("id-ID")); render();}
}

