    <div style="margin-top:8px;font-size:10px;color:#64748b">Tips: Izinkan akses kamera. Di HP Android Chrome, scan barcode produk / QR akan otomatis terdeteksi jika support BarcodeDetector.</div>`;
  openModal(scannerHtml);
  startCameraScanner();
}
let cameraStream = null;
async function startCameraScanner(){
  try{
    const video = document.getElementById("barcodeVideo");
    if(!video) return;
    cameraStream = await navigator.mediaDevices.getUserMedia({video:{facingMode:"environment"}});
    video.srcObject = cameraStream;
    if('BarcodeDetector' in window){
      const detector = new BarcodeDetector({formats:['ean_13','ean_8','code_128','code_39','qr_code']});
      const scanLoop = async ()=>{
        if(!document.getElementById("barcodeVideo")) return;
        try{
          const barcodes = await detector.detect(video);
          if(barcodes.length>0){
            const code = barcodes[0].rawValue;
            submitBarcodeResult(code);
            return;
          }
        }catch(e){}
        requestAnimationFrame(scanLoop);
      };
      scanLoop();
    }
  }catch(e){
    const vid = document.getElementById("barcodeVideo");
    if(vid) vid.parentElement.innerHTML = `<div style="color:#fff;text-align:center;padding:20px;font-size:12px">❌ Kamera tidak bisa diakses<br>${e.message}<br><br>Gunakan input manual di bawah</div>`;
  }
}
function closeBarcodeScanner(){
  if(cameraStream){cameraStream.getTracks().forEach(t=>t.stop()); cameraStream=null;}
